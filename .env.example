# Copy to .env and fill in real values. Never commit .env.

# Use an ABSOLUTE file: path here. A relative path resolves against prisma/
# for `migrate` but against the process working directory for the app itself,
# silently connecting the app to an empty database (P2021 on every table).
DATABASE_URL="file:C:/full/path/to/BloxAstra/prisma/bloxastra.db"
# Production example:
# DATABASE_URL="postgresql://user:pass@host:5432/bloxastra"

SESSION_SECRET="generate-a-32-byte-random-hex-string"

# Identity of the operator, printed on /kebijakan-privasi, /syarat-layanan,
# and /tentang. While address/email/phone/PSE are empty those pages show a
# "halaman ini belum lengkap" warning — fill these and it disappears.
# Read at request time: edit .env and `pm2 restart bloxastra-web` (no deploy).
LEGAL_OPERATOR_ENTITY="AstraFlow Digital"
LEGAL_OPERATOR_ADDRESS=""
LEGAL_OPERATOR_EMAIL=""
LEGAL_OPERATOR_PHONE=""
# Electronic System Provider registration number (PP 71/2019 Pasal 6):
LEGAL_OPERATOR_PSE_NUMBER=""
LEGAL_OPERATOR_MIN_AGE="13 tahun"

PAYMENT_PROVIDER="sim"
# Live gateway: "tripay" (MIDTRANS_* keys below are legacy, kept only for
# invoices created before the switch).
TRIPAY_API_KEY=""
TRIPAY_PRIVATE_KEY=""
TRIPAY_MERCHANT_CODE=""
TRIPAY_IS_PRODUCTION="false"
# Our checkout method -> one concrete Tripay channel per transaction
# (must be active on the Tripay merchant account):
TRIPAY_QRIS_CHANNEL="QRIS"
TRIPAY_VA_CHANNEL="BRIVA"
TRIPAY_EWALLET_CHANNEL="QRIS"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Blog subdomain (host-routed by src/proxy.ts, served by this same app).
# Articles live at the root of this host: blog.example.com/<slug>.
NEXT_PUBLIC_BLOG_URL="https://blog.bloxastra.com"

# OAuth login. Leave a provider's pair empty to hide its login button.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AES-256-GCM key for order credentials (64 hex chars = 32 bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Self-hosted WhatsApp OTP bot (wa-bot/bot.mjs, PM2 app "bloxastra-wa").
# Set BOTH to enable real sending. Without WA_BOT_TOKEN the flow runs in sim
# mode in dev and is REFUSED in production.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WA_BOT_TOKEN=""
WA_BOT_URL="http://127.0.0.1:3140"
WA_BOT_PORT="3140"
# Optional: WhatsApp number of the bot, to use a pairing code instead of the QR
# (e.g. 628123456789). Leave empty to print a QR in `pm2 logs bloxastra-wa`.
WA_BOT_PAIRING_NUMBER=""

# Cloudflare Turnstile anti-bot on the login + register forms. Leave both
# empty to disable (local dev). Set BOTH to activate; once the secret is set
# verification is mandatory.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Bearer token for /api/cron/sweep (Vercel Cron sends it automatically when
# set in project env; required in production, optional locally):
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# Local sweep without deploy: curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/sweep

# Token API blog untuk otomasi (POST/GET /api/blog/posts). Buat acak 48+ karakter.
BLOG_API_TOKEN=
