# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-verify/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# runtime artifacts (PM2 logs, PID files, ad-hoc temp scripts/logs)
/logs/
*.log
*.pid
tmp-*

# agent/tool state
/.freebuff/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma / sqlite
/prisma/bloxastra.db
/prisma/bloxastra.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
