# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
# `.next*` covers the deployed tree plus any NEXT_DIST_DIR sibling
# (.next-dev for the dev server, .next-verify for throwaway builds).
/.next*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# runtime artifacts (PM2 logs, PID files, ad-hoc temp scripts/logs)
/logs/
*.log
*.pid
tmp-*

# agent/tool state
/.freebuff/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma / sqlite
/prisma/bloxastra.db
/prisma/bloxastra.db-journal
# salinan DB untuk verifikasi (dibuat tools/prepare-verify-db.mjs, tidak pernah
# dipakai aplikasi dan tidak boleh masuk repo)
/prisma/verify.db
/prisma/verify.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
